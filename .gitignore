data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm

# Python caches and bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# OS and IDE files
.DS_Store
.idea/
.vscode/

# Build and distribution
build/
dist/
*.egg-info/
