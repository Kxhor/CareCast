# CareCast Environment Configuration (TRD §8)
# No secrets exist in this design. Values are loaded from process environment or TOML defaults.

# Environment: 'dev' enables debug reload helpers and optional docs; 'prod' disables them.
CARECAST_ENV=prod

# SQLite database path (must be outside web/)
CARECAST_DB_PATH=data/carecast.db

# Enable interactive API docs (/docs, /redoc, /openapi.json); honoured ONLY when CARECAST_ENV=dev
CARECAST_ENABLE_DOCS=0

# Rate limits (requests per minute)
CARECAST_RATE_GET_PER_MIN=60
CARECAST_RATE_POST_PER_MIN=20

# Trust X-Forwarded-For header: 1 to trust (only behind a known reverse proxy), 0 otherwise
CARECAST_TRUSTED_PROXY=0

# HTTP Strict Transport Security: 1 to send HSTS header (only when served over HTTPS)
CARECAST_HSTS=0

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
CARECAST_LOG_LEVEL=INFO
